{
  "name": "dennysh-portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:static": "node scripts/test-static.mjs",
    "verify": "bash scripts/verify.sh",
    "build:e2e": "VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA OUT_DIR=dist-e2e vite build --outDir dist-e2e && OUT_DIR=dist-e2e node scripts/prerender.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
