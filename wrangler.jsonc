{
  // Configuración de Cloudflare Pages (sin secretos). Los secretos van en variables cifradas del panel y en .dev.vars (ignorado por git).
  "name": "dennysh",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dennysh-demo",
      // Marcador: Dennys pone aquí el id real al crear la base (runbook T063). Para desarrollo local no importa.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
